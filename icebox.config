# -*- mode: conf; coding: utf-8 -*-

IceBox.Service.SampleService1 = SampleService.Service --Ice.Config=icebox.config
IceBox.Service.SampleService2 = SampleService.Service --Ice.Config=icebox.config
IceBox.Service.SampleService3 = SampleService.Service --Ice.Config=icebox.config

IceBox.LoadOrder = SampleService1, SampleService2, SampleService3

IceBox.ServiceManager.Endpoints = tcp -h localhost -p 9999


IceStorm.TopicManager.Endpoints = tcp -h 127.0.0.1 -p 10000
IceStorm.Publish.Endpoints      = tcp -h 127.0.0.1 -p 10001

