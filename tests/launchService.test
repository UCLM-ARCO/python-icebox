# -*- mode: python; coding: utf-8 -*-

def createConfigs(kwargs):
    for name,content in kwargs.items():
        f = None
        try:
            f = open(name, "w")
            f.write(content)
            f.flush()
        finally:
            if f: f.close()
    return 0

config_icebox = '''
IceBox.Service.TestService = TestService.ServiceI --Ice.Config=service.config
'''
config_service = '''
TestServiceOA.Endpoints = tcp -h localhost -p 9988
'''

configs = TaskFunc(createConfigs,
                   [{"icebox.config":config_icebox,
                     "service.config":config_service}])
configs.gen += ["icebox.config", "service.config"]


def testClient(str_prx):
    import Ice
    Ice.loadSlice("Test.ice -I /usr/share/slice")
    import Test

    ice = Ice.initialize()
    prx = ice.stringToProxy(str_prx)
    prx = Test.TestIntfPrx.checkedCast(prx)
    return 0


# Launch service
str_prx = "TestServiceObject -t:tcp -h localhost -p 9988"
d = Daemon("../pyicebox --Ice.Config=icebox.config",
           env={"PYTHONPATH":"."})
d.pre += Not(OpenPort(9988))


# Object is reachable?
t = TaskFunc(testClient, [str_prx])
t.pre += Poll(OpenPort(9988), 0.2, 2)

