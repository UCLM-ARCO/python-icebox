# -*- mode: python; coding: utf-8 -*-

port = 9988

# Create config
config_file = "$testdir/service.cfg"
config_data = """
IceBox.Service.TestService = TestService.ServiceI --Ice.Config={0}
TestServiceOA.Endpoints = tcp -h localhost -p {1}
""".format(config_file, port)

cfg = Test("echo '{0}' > {1}".format(config_data, config_file), shell=True)
cfg.gen += config_file


# Launch service
str_prx = "TestServiceObject -t:tcp -h localhost -p {}".format(port)
d = Daemon("$basedir/icebox/pyicebox --Ice.Config={0}".format(config_file),
           env={"PYTHONPATH":"$basedir:$testdir"})
d.pre += Not(OpenPort(port))


# Object is reachable?
t = Test("$testdir/check_object.py '{0}'".format(str_prx))
t.pre += TaskRunning(d)
t.pre += Poll(OpenPort(port))

